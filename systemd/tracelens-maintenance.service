[Unit]
Description=TraceLens Maintenance
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=tracelens
Group=tracelens
WorkingDirectory=/opt/tracelens
EnvironmentFile=/etc/tracelens/tracelens.env
ExecStart=/opt/tracelens/start_maintenance.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
