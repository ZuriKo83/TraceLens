[Unit]
Description=TraceLens Web
After=network-online.target postgresql.service redis-server.service
Wants=network-online.target
Requires=postgresql.service redis-server.service

[Service]
Type=simple
User=tracelens
Group=tracelens
WorkingDirectory=/opt/tracelens
EnvironmentFile=/etc/tracelens/tracelens.env
ExecStartPre=/opt/tracelens/.venv/bin/alembic upgrade head
ExecStart=/opt/tracelens/start_web.sh
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
