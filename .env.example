APP_NAME=TraceLens
POSTGRES_PASSWORD=local-development-only
SESSION_SECRET=replace-with-a-long-random-local-secret
PUBLIC_BASE_URL=http://localhost:8021
EXTENSION_STORE_URL=
SECURE_COOKIES=false
DEBUG_MAGIC_LINKS=true
LOGIN_TOKEN_MINUTES=20
COLLECTOR_TOKEN_DAYS=30
COLLECTOR_MAX_ITEMS=1000

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

ADMIN_EMAILS=
FIRST_USER_IS_ADMIN=false

REDIS_URL=redis://127.0.0.1:6379/0
QUEUE_NAME=collector
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_VERIFICATION_PER_HOUR=5
RATE_LIMIT_COLLECTOR_PER_MINUTE=30
SCAN_LOG_RETENTION_DAYS=30
SCAN_ARCHIVE_DIR=./archives
SCAN_ARCHIVE_DELETE_DELAY_HOURS=24

SESSION_COOKIE_NAME=tracelens_session
SESSION_MAX_AGE_SECONDS=2592000
SESSION_REDIS_PREFIX=session:
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
